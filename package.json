{
  "name": "@ingress/workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/types",
    "packages/reflect-annotations",
    "packages/core",
    "packages/http",
    "packages/router-tree-map",
    "packages/router",
    "packages/ingress",
    "packages/typebox",
    "packages/zod",
    "packages/example"
  ],
  "packageManager": "npm@11.4.0",
  "engines": {
    "node": ">=22",
    "npm": "11.4.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "node --test **/*.test.js --enable-source-maps",
    "update-deps": "syncpack update",
    "check:deps": "syncpack fix-mismatches",
    "ci:lint": "biome lint",
    "ci:format": "biome format",
    "fix:lint": "biome lint --write",
    "fix:format": "biome format --write"
  },
  "devDependencies": {
    "node-test-github-reporter": "^1.3.1",
    "@biomejs/biome": "^1.9.4",
    "@lerna-lite/publish": "^4.1.2",
    "@lerna-lite/version": "^4.1.2",
    "@swc/core": "^1.11.24",
    "@types/node": "22.15.21",
    "strip-json-comments": "^5.0.2",
    "syncpack": "^13.0.4",
    "typescript": "^5.8.3"
  }
}
