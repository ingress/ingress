{
  "name": "router-tree-map",
  "version": "1.0.0",
  "keywords": [
    "radix",
    "trie",
    "tree",
    "router",
    "path",
    "http route"
  ],
  "author": "Caleb Boyd <caleb.boyd@hotmail.com> (https://github.com/calebboyd)",
  "license": "MIT",
  "description": "A radix tree map-like structure for /route/:like/keys and values",
  "type": "commonjs",
  "exports": {
    ".": {
      "node": {
        "import": "./index.mjs",
        "require": "./lib/cjs/tree.js",
        "types": "./lib/cjs/tree.d.ts",
        "default": "./lib/cjs/tree.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.{js,map,d.ts}"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc",
    "test": "$npm_execpath run build && node --test --enable-source-maps"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
