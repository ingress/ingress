{
  "name": "@ingress/core",
  "version": "1.0.0-beta.16",
  "keywords": [],
  "author": "Caleb Boyd <caleb.boyd@hotmail.com> (https://github.com/calebboyd)",
  "license": "MIT",
  "description": "Core ingress objects, application lifecycle and http handlers",
  "type": "commonjs",
  "files": [
    "lib/**/*.{js,map,d.ts}"
  ],
  "main": "./lib/cjs/core.js",
  "types": "./lib/cjs/core.d.ts",
  "exports": {
    ".": {
      "import": "./lib/esm/core.js",
      "require": "./lib/cjs/core.js",
      "types": "./lib/esm/core.d.ts",
      "default": "./lib/cjs/core.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf lib && tsc",
    "pretest": "npm run build",
    "test": "node --test --enable-source-maps"
  },
  "dependencies": {
    "injection-js": "^2.4.0",
    "reflect-annotations": "*"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
