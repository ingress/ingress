{
  "name": "@ingress/router",
  "version": "1.0.0-beta.16",
  "keywords": [
    "radix",
    "trie",
    "tree",
    "router",
    "path",
    "http route"
  ],
  "author": "Caleb Boyd <caleb.boyd@hotmail.com> (https://github.com/calebboyd)",
  "license": "MIT",
  "description": "A fast router middleware for ingress",
  "type": "commonjs",
  "types": "./lib/cjs/router.d.ts",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "types": "./lib/cjs/router.d.ts",
      "require": "./lib/cjs/router.js",
      "default": "./lib/esm/router.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs"
  ],
  "scripts": {
    "test": "node --test --enable-source-maps",
    "build:cjs": "tsc",
    "build": "rm -rf lib && $npm_execpath run build:cjs"
  },
  "dependencies": {
    "@ingress/core": "file://../core",
    "@ingress/types": "file://../types",
    "reflect-annotations": "file://../reflect-annotations",
    "router-tree-map": "file://../router-tree-map",
    "secure-json-parse": "^2.7.0"
  },
  "devDependencies": {
    "@ingress/http": "file://../http",
    "@hapi/shot": "6.0.1"
  }
}
