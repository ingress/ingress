{
  "name": "@ingress/router",
  "version": "1.0.0-beta.17",
  "keywords": [
    "radix",
    "trie",
    "tree",
    "router",
    "path",
    "http route"
  ],
  "author": "Caleb Boyd <caleb.boyd@hotmail.com> (https://github.com/calebboyd)",
  "license": "MIT",
  "description": "A fast router middleware for ingress",
  "type": "commonjs",
  "types": "./lib/cjs/router.d.ts",
  "exports": {
    ".": {
      "node": {
        "import": "./index.mjs",
        "require": "./lib/cjs/router.js",
        "types": "./lib/cjs/router.d.ts",
        "default": "./lib/cjs/router.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/**/*.{js,map,d.ts}",
    "docs"
  ],
  "scripts": {
    "test": "npm run build && node --test --enable-source-maps",
    "build": "rm -rf lib && tsc"
  },
  "dependencies": {
    "@ingress/core": "1.0.0-beta.17",
    "@ingress/types": "1.0.0-beta.17",
    "reflect-annotations": "4.0.0-beta.2",
    "router-tree-map": "1.0.0-beta.17",
    "secure-json-parse": "4.0.0"
  },
  "devDependencies": {
    "@ingress/http": "1.0.0-beta.17",
    "@hapi/shot": "6.0.1"
  }
}
