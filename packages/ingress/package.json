{
  "name": "ingress",
  "version": "1.0.0-beta.17",
  "description": "Composable javascript applications",
  "type": "commonjs",
  "exports": {
    ".": {
      "require": "./lib/cjs/ingress.js",
      "types": "./lib/cjs/ingress.d.ts",
      "default": "./lib/cjs/ingress.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/**/*.{js,map,d.ts}",
    "bin/**/*.mjs"
  ],
  "scripts": {
    "test": "npm run build && node --test --enable-source-maps",
    "build": "rm -rf lib && tsc"
  },
  "repository": {
    "directory": "packages/ingress",
    "type": "git",
    "url": "ssh://git@github.com/ingress/ingress.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "keywords": [
    "typescript",
    "server",
    "http",
    "application",
    "framework",
    "composable",
    "declarative",
    "middleware"
  ],
  "dependencies": {
    "@ingress/core": "1.0.0-beta.17",
    "@ingress/http": "1.0.0-beta.17",
    "@ingress/router": "1.0.0-beta.17",
    "reflect-metadata": "0.2.2",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@sinclair/typebox": "0.34.33",
    "@hapi/shot": "6.0.1"
  }
}
