{
  "name": "reflect-annotations",
  "version": "4.0.0-beta.2",
  "description": "Set and inspect annotation metadata on JavaScript classes and methods",
  "repository": {
    "type": "git",
    "url": "https://github.com/ingress/ingress"
  },
  "type": "commonjs",
  "main": "./lib/cjs/index.js",
  "types": "./lib/cjs/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "import": "./index.mjs",
        "require": "./lib/cjs/index.js",
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/**/*.{js,map,d.ts}"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rm -rf lib && tsc",
    "test": "node --test --enable-source-maps"
  },
  "author": "Caleb Boyd <caleb.boyd@hotmail.com> (https://github.com/calebboyd)",
  "license": "MIT",
  "peerDependencies": {
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "reflect-metadata": "0.2.2",
    "typescript": "^5.8.3"
  }
}
